{
  "workflow_revision": "ai-team-2026-08-14-r41",
  "enums": {
    "gates": ["task-design", "implementation-ready", "verified-complete"],
    "task_states": ["analysis", "awaiting-human-decision", "task-design-ready", "implementation-ready", "implementing", "awaiting-verification", "complete", "cancelled/superseded"],
    "technical_outcomes": ["not-complete", "verified-complete"],
    "lanes": ["fast", "standard", "high-risk"],
    "complexities": ["s", "m", "l", "xl"],
    "project_stages": ["analysis-only", "implementation-authorized", "verification-only"],
    "control_triggers": ["none", "baseline-change", "experience", "web-ui", "testsprite", "external-integration", "interface", "security", "runtime-chain"],
    "owner_roles": ["delivery coordinator", "product analyst", "ux/ui designer", "technical lead", "serial implementation engineer", "independent verifier", "code and security reviewer"],
    "next_gates": ["task-design", "implementation-ready", "verified-complete", "human-acceptance", "none"],
    "checkpoint_modes": ["none", "blocking", "non-blocking"],
    "checkpoint_statuses": ["not-required", "pending", "accepted", "rejected", "conditional"],
    "finding_severities": ["P0", "P1", "P2"],
    "review_phases": ["intake", "baseline", "task-design", "implementation-readiness", "fast-design-readiness", "verification", "code-security"],
    "credential_treatments": ["mockable", "equivalent-fallback", "non-substitutable"],
    "credential_statuses": ["configured-redacted", "notified-needed-now", "notified-deferred", "notified-optional", "fallback-active"],
    "credential_deadlines": ["implementation-ready", "verified-complete", "human-acceptance"]
  },
  "stage_authority": {
    "task-design": ["analysis-only", "implementation-authorized", "verification-only"],
    "implementation-ready": ["implementation-authorized"],
    "verified-complete": ["implementation-authorized", "verification-only"]
  },
  "lane_contracts": {
    "fast": {
      "readiness_section": "Fast merged design/readiness",
      "execution_section": "Fast execution and verification",
      "allowed_inventory_patterns": [
        "(^|/)(docs?|documentation)/",
        "(^|/)(tests?|__tests__)/",
        "(^|/)(styles?|themes?|tokens?|locales?|i18n|copy)/",
        "(^|/)(README|CONTRIBUTING|CHANGELOG|LICENSE)(\\.[^/]+)?$",
        "\\.(md|mdx|rst|adoc|txt|css|scss|sass|less)$",
        "\\.(test|spec)\\.[^/]+$"
      ]
    },
    "standard": {
      "readiness_section": "Plan and readiness",
      "execution_section": "Implementation self-check"
    },
    "high-risk": {
      "readiness_section": "Plan and readiness",
      "execution_section": "Implementation self-check"
    }
  },
  "formats": {
    "pass_result": {
      "expectation": "start with PASS; prose that merely contains PASS is not a passing status",
      "example": "PASS — python -m pytest tests/ -v; 5/5 passed"
    },
    "reasoned_na": {
      "expectation": "start with N/A and include a concrete rationale",
      "example": "N/A — this project has no separate build step"
    },
    "no_findings": {
      "expectation": "write none, optionally followed by a concrete verification reason; N/A is not required",
      "example": "none — no findings after TEST-001, TEST-002, and TEST-003"
    },
    "finding_record": {
      "expectation": "record each finding as a FIND/EVID ID immediately followed by P0, P1, or P2 and affected traceability",
      "example": "FIND-001 / P1 / REQ-001 AC-001 TEST-001 / reproduction and disposition"
    },
    "fingerprint_ledger": {
      "expectation": "put each project-relative path and 64-hex SHA-256 digest on its own Markdown list line",
      "example": "- `src/file.ts` = 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    },
    "serial_task_order": {
      "expectation": "list every batch member TASK ID exactly once in execution order",
      "example": "TASK-001 → TASK-002"
    },
    "repomix_initialization": {
      "expectation": "for existing-code, start with PASS and name Repomix version, runner, exact command, scope, exclusions, and file or token metrics; for greenfield, use reasoned N/A",
      "example": "PASS — Repomix 1.9.0; runner=npx --yes repomix@latest; command=npx --yes repomix@latest --compress ...; scope=.; exclusions=.ai-team,node_modules,.env*; files=120; tokens=45000"
    },
    "testsprite_batch_exit": {
      "expectation": "start with PASS and record prerequisite-at, TestSprite-final=PASS, run, candidate snapshots, explicit TEST IDs, report, visual-evidence, and testsprite-at; TestSprite must be later than prerequisite tests",
      "example": "PASS — EVID-BATCH-001; prerequisite-at=2026-08-14T10:00+08:00; TestSprite-final=PASS; run=TS-RUN-001; candidate=SNAP-UI-001; tests=TEST-UI-001 TEST-UI-002; report=`testsprite_tests/TestSprite_MCP_Test_Report.md`; visual-evidence=`testsprite_tests/tmp/test_results.json`; testsprite-at=2026-08-14T10:20+08:00"
    }
  },
  "fields": {
    "snapshot": ["Workflow revision:", "Snapshot ID and updated at:", "Current state and technical outcome:", "Scope, source, decision, and contract references:", "Delivery lane / complexity / control triggers:", "Batch / dependencies / entry:", "Change-set file inventory:", "Fingerprint policy:", "Current change-set fingerprint:", "Actor identities:", "Open findings / blockers:", "Next action, exit condition, and invalidation:"],
    "planning": ["Baseline and design references:", "Test Manifest revision and frozen-at:", "Implementer checks:", "Independent task verification:", "Batch regression:", "Risk and contract checks:", "Environment / data / reset:", "Planning verifier and report:", "Design/readiness verdict and conditions:"],
    "self_check": ["Implementation engineer identity:", "Build / generation / lint-typecheck results:", "Owner / affected / contract test results:", "Omitted checks, residual risks, and evidence:"],
    "verification": ["Independent verifier identity:", "Separate code/security reviewer identity:", "Independent verifier verdict:", "Separate code/security reviewer verdict:", "Independent verification evidence:", "Separate code/security review evidence:", "Findings / severity / affected REQ-AC-TEST:", "Open P0/P1 / P2 follow-up:", "Verified Snapshot / Manifest / at:"],
    "fast_gate": ["Independent verifier identity:", "Report:", "Scope / acceptance / checks:", "Verdict:", "Invalidated by:"],
    "fast_completion": ["Implementer / self-check / evidence:", "Independent verifier / verdict / evidence:", "Findings / severity / affected / follow-up:", "Verified Snapshot / at:"],
    "runtime": ["Trigger:", "Entry → authorization/precondition → scheduling or claim → state transition → side effect → recovery/compensation → observable result:", "REQ / AC / module / test mapping for each critical stage:"],
    "security": ["Triggered:", "Review:", "Required mitigations and negative tests:"],
    "testsprite_design": ["Provider-neutral TEST IDs and source oracles:", "Local service, MCP/config readiness, and project path:", "Account, allowed actions, data, and cleanup:", "Coverage map:", "Final-gate plan:"],
    "testsprite_completion_extra": ["Prerequisite suites / evidence / completed at:", "Final TestSprite run / candidate / completed at:", "TestSprite result / report / visual evidence:", "Independent verifier evidence:"],
    "layout_authority": ["Project rules:", "Delivery policy:", "Role protocol:", "Artifact templates:", "Workflow schema:", "Project stage:", "Handoff validator:", "Markdown section extractor:", "Project consistency checker:", "Fingerprint ledger helper:"],
    "source_register": ["Type:", "URL or verbatim request:", "Authority:", "Status:", "Version or updated at:", "Read at:"],
    "code_baseline": ["Repository / directory:", "Mode:", "Repomix initialization:", "Baseline description:", "Modules and tests inspected:", "Read at:"],
    "acceptance_intake": ["Source:", "Status:", "Product analyst:", "Independent review:", "Evidence-backed rules:", "Conventional low-risk MVP assumptions and rationale:", "Awaiting material human decision:"],
    "acceptance_scope": ["In scope:", "Out of scope:"],
    "review_evidence": ["Reviewer identity:", "Role:", "Review phase:", "Snapshot and Manifest:", "Reviewed scope and inputs:", "Commands or inspection performed:", "Evidence and findings:", "Verdict:", "Invalidated by:", "Recorded at:"],
    "cancellation": ["Date:", "Outcome:", "Feedback and evidence:", "Classification:", "Linked requirements and tasks:", "Decision:", "Next action:"],
    "credential_readiness": ["Applicability:", "Consolidated user-action notice:"]
  },
  "tables": {
    "traceability_columns": ["Requirement", "Requirement source and classification", "State", "Acceptance criteria", "Source/Demo evidence", "Baseline impact", "Quality treatment", "Design and task", "Test case/method", "Decision"],
    "backlog_columns": ["ID", "Task", "State", "Lane", "Complexity", "Batch", "Owner role", "Dependencies", "Blocker / decision", "Next gate", "Card"],
    "batch_columns": ["Batch", "Objective", "Member tasks", "Serial implementation order", "Entry criteria", "Exit evidence", "Acceptance checkpoint", "Checkpoint mode", "Checkpoint status"],
    "credential_readiness_columns": ["Integration", "Credential/config key names", "Contract/source", "Treatment", "Safe local target/scaffold", "Action/readiness status", "TEST IDs (mock/fallback; live)", "Affected TASK/latest-needed gate", "Redacted probe"]
  }
}
